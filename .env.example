# Local Neo4j credentials and endpoint.
#
# Copy this file to `.env` in the repository root and set a password:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not. Never put a real password in this file.
#
# NEO4J_PASSWORD is deliberately left empty. `compose.yaml` fails fast on an empty value, so
# an unedited copy cannot quietly start a database whose password is published in this
# repository — which is what a plausible-looking placeholder would do, since Neo4j refuses
# only the literal string `neo4j` and anything under 8 characters.
#
# Two characters to avoid, because Compose and a naive reader disagree about them: `$` is
# interpolated away by Compose before the container ever sees it, and surrounding quotes are
# stripped by Compose but not by a plain split-on-`=` parser. Either produces a container that
# starts healthy and then rejects the driver's credentials with no hint as to why. Letters and
# digits, 8 characters or more, are safe.
#
# Both `compose.yaml` and the Python driver read these, so the container and the client agree
# about who is connecting.

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# OpenAI API key, read by the story layer's OpenAI provider (MULTI_PROVIDER_OPENAI §4.3).
#
# Deliberately empty, for the same reason NEO4J_PASSWORD is: a plausible-looking placeholder
# would be a claim that a key exists. With this unset the OpenAI provider is reported
# *unavailable with a reason* rather than failing at request time, and the demo UI renders it
# disabled — so an unedited copy of this file is a working configuration, not a broken one.
#
# It never reaches a tracked file, a run artifact or the browser: `story/providers/public.py`
# refuses an `api_key` in `config/story.yaml`, and the provider catalogue the UI reads carries
# no credential, no endpoint and no environment value.
OPENAI_API_KEY=

# SEC EDGAR User-Agent, read by the acquisition layer (config/fetch.yaml `http.user_agent`).
#
# SEC requires one naming the application and a contact email; requests without a real contact
# risk being blocked. The tracked config carries only a placeholder, so set yours here rather
# than editing a tracked file. Not part of config_hash: changing it never changes a run id.
#
#     SEC_USER_AGENT=Financial-KG-Prototype you@example.com
SEC_USER_AGENT=
