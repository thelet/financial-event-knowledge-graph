# Downloaded bytes, derived catalogs, run outputs and staging.
# Regenerable from config/ + manifests/, which ARE tracked.
data/

# Secrets and local configuration
.env
.env.*
!.env.example
*.local.yaml
*.local.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / frontend
node_modules/
.next/
.vite/
coverage/

# Graph backends and local databases
*.db
*.sqlite
*.sqlite3
neo4j_data/
neo4j_logs/
falkordb_data/
*.dump

# Compose auto-loads these, which makes them the natural home for a local port or credential
# override — and the natural way to commit one by accident.
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
